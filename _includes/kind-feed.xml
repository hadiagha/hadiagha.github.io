{%- comment -%}
  Atom feed for a single content kind. Included by the four files in feeds/,
  each of which sets `kind` in its front matter.

  jekyll-feed builds /feed.xml, which carries everything. It can also split by
  category, but `kind` is a front-matter field of our own rather than a Jekyll
  category, so it cannot see it — hence a hand-written template.

  The point of splitting is that the kinds are genuinely different commitments
  on a reader's time: someone who wants the long worked articles should not
  have to take every short note to get them.
{%- endcomment -%}
{%- assign feed_kind = include.kind -%}
{%- assign feed_posts = site.posts | where: "kind", feed_kind -%}
{%- assign feed_url = page.url | absolute_url -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title type="text">{{ site.title }} — {{ include.label }}</title>
  <subtitle type="text">{{ include.description }}</subtitle>
  <id>{{ feed_url }}</id>
  <link rel="self" type="application/atom+xml" href="{{ feed_url }}"/>
  <link rel="alternate" type="text/html" href="{{ '/blog/' | absolute_url }}"/>
  {%- comment -%}
    updated must be the newest post's date, not the build time. Using "now"
    would tell every reader the feed had changed on every deploy, so a reader
    who checks hourly would see it as perpetually fresh and stop trusting it.
    With no posts of this kind yet, fall back to the site's newest post, and
    failing that to the epoch — an empty feed still has to parse.
  {%- endcomment -%}
  {%- if feed_posts.size > 0 -%}
    {%- assign feed_updated = feed_posts.first.date | date_to_xmlschema -%}
  {%- elsif site.posts.size > 0 -%}
    {%- assign feed_updated = site.posts.first.date | date_to_xmlschema -%}
  {%- else -%}
    {%- assign feed_updated = "1970-01-01T00:00:00Z" -%}
  {%- endif -%}
  <updated>{{ feed_updated }}</updated>
  <author>
    <name>{{ site.author.name }}</name>
    <uri>{{ '/' | absolute_url }}</uri>
  </author>
  <rights>© {{ 'now' | date: '%Y' }} {{ site.author.name }}</rights>
  <generator uri="https://jekyllrb.com/" version="{{ jekyll.version }}">Jekyll</generator>

  {%- for post in feed_posts limit: 30 %}
  <entry>
    <title type="html">{{ post.title | smartify | strip_html | normalize_whitespace | xml_escape }}</title>
    <link rel="alternate" type="text/html" href="{{ post.url | absolute_url }}"/>
    <id>{{ post.url | absolute_url }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    {%- assign revised = post.updated | default: post.last_modified_at | default: post.date %}
    <updated>{{ revised | date_to_xmlschema }}</updated>
    <summary type="html">{{ post.description | default: post.excerpt | strip_html | normalize_whitespace | xml_escape }}</summary>
    <content type="html" xml:base="{{ post.url | absolute_url }}">{{ post.content | strip | xml_escape }}</content>
    {%- for tag in post.tags %}
    <category term="{{ tag | xml_escape }}"/>
    {%- endfor %}
  </entry>
  {%- endfor %}
</feed>
